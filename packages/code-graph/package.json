{
  "name": "code-graph",
  "version": "0.1.0",
  "description": "Graph-based code intelligence for Claude Code — BM25 + multi-hop retrieval over TypeScript/React codebases, in an embedded SQLite store",
  "repository": {
    "type": "git",
    "url": "https://github.com/lichens-ai/code-graph.git"
  },
  "homepage": "https://github.com/lichens-ai/code-graph#readme",
  "keywords": [
    "code-graph",
    "claude-code",
    "typescript",
    "rag",
    "code-intelligence",
    "sqlite"
  ],
  "bin": {
    "code-graph": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./query": {
      "types": "./dist/query/queries.d.ts",
      "default": "./dist/query/queries.js"
    },
    "./scribe/db": {
      "types": "./dist/scribe/db.d.ts",
      "default": "./dist/scribe/db.js"
    },
    "./scribe/bootstrap": {
      "types": "./dist/scribe/bootstrap.d.ts",
      "default": "./dist/scribe/bootstrap.js"
    },
    "./scribe/rows": {
      "types": "./dist/scribe/rows.d.ts",
      "default": "./dist/scribe/rows.js"
    },
    "./scribe/delete-concept": {
      "types": "./dist/scribe/delete-concept.d.ts",
      "default": "./dist/scribe/delete-concept.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "prettier --check . --ignore-path ../../.prettierignore",
    "format": "prettier --write . --ignore-path ../../.prettierignore"
  },
  "files": [
    "dist",
    "eval/tasks.json",
    "package.json",
    "README.md"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "commander": "^14.0.3",
    "minimatch": "^10.2.5",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.5"
  }
}
