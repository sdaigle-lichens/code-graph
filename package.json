    "code-graph",
    "claude-code",
    "typescript",
    "rag",
    "code-intelligence",
    "sqlite"
  ],
  "bin": {
    "code-graph": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "files": [
